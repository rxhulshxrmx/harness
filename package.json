{
  "name": "couplet",
  "displayName": "Couplet",
  "description": "An agentic coding assistant running inside VS Code, powered by SAP AI Core.",
  "publisher": "sharma-so",
  "version": "0.0.12",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "package": "vsce package"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "couplet",
          "title": "Couplet",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "couplet": [
        {
          "type": "webview",
          "id": "couplet.chat",
          "name": "Couplet Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "couplet.newSession",
        "title": "Couplet: New Session"
      }
    ],
    "configuration": {
      "properties": {
        "couplet.clientId": {
          "type": "string",
          "default": "",
          "description": "SAP AI Core client ID (Set via the Couplet settings panel, not this field, is recommended)."
        },
        "couplet.aiCoreBaseUrl": {
          "type": "string",
          "default": "",
          "description": "SAP AI Core API base URL (serviceurls.AI_API_URL from your service key)."
        },
        "couplet.tokenUrl": {
          "type": "string",
          "default": "",
          "description": "SAP AI Core OAuth token URL (the \"url\" field from your service key)."
        },
        "couplet.deploymentId": {
          "type": "string",
          "default": ""
        },
        "couplet.resourceGroup": {
          "type": "string",
          "default": "default"
        },
        "couplet.apiVersion": {
          "type": "string",
          "default": "2024-10-21"
        },
        "couplet.model": {
          "type": "string",
          "default": ""
        },
        "couplet.approvalMode": {
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ],
          "default": "ask"
        },
        "couplet.contextBudget": {
          "type": "number",
          "default": 100000
        }
      }
    }
  },
  "dependencies": {
    "ignore": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}

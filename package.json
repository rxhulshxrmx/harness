{
  "name": "harness",
  "displayName": "Harness",
  "description": "An agentic coding assistant running inside VS Code, powered by SAP AI Core.",
  "publisher": "internal",
  "version": "0.0.4",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rxhulshxrmx/harness.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "package": "vsce package"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harness",
          "title": "Harness",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "harness": [
        {
          "type": "webview",
          "id": "harness.chat",
          "name": " "
        }
      ]
    },
    "commands": [
      {
        "command": "harness.newSession",
        "title": "Harness: New Session"
      },
      {
        "command": "harness.ping",
        "title": "Harness: Ping (debug)"
      }
    ],
    "configuration": {
      "properties": {
        "harness.serviceKeyPath": {
          "type": "string",
          "default": ""
        },
        "harness.deploymentId": {
          "type": "string",
          "default": ""
        },
        "harness.resourceGroup": {
          "type": "string",
          "default": "default"
        },
        "harness.apiVersion": {
          "type": "string",
          "default": "2024-10-21"
        },
        "harness.model": {
          "type": "string",
          "default": ""
        },
        "harness.approvalMode": {
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ],
          "default": "ask"
        },
        "harness.contextBudget": {
          "type": "number",
          "default": 100000
        }
      }
    }
  },
  "dependencies": {
    "ignore": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
